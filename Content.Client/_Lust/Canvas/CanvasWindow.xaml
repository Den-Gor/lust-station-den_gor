<canvas:CanvasWindow xmlns="https://spacestation14.io"
    xmlns:canvas="clr-namespace:Content.Client._Lust.Canvas"
    MouseFilter="Stop" Resizable="True" MinSize="400 400"
    SetSize="520 600">
    <BoxContainer Name="ContentsRoot" Orientation="Vertical">
        <PanelContainer VerticalExpand="True" HorizontalExpand="True">
            <Control Name="CanvasHost" VerticalExpand="True" HorizontalExpand="True"/>
        </PanelContainer>
        <BoxContainer Name="EditButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6" SeparationOverride="4">
            <Button Name="UndoButton" Text="Отменить"/>
            <Button Name="SaveButton" Text="Сохранить"/>
        </BoxContainer>
    </BoxContainer>
</canvas:CanvasWindow>
